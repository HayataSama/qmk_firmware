{
    "manufacturer": "HayataSama",
    "keyboard_name": "hayatasama/sakurajimasplit",
    "maintainer": "HayataSama",
    "url": "https://github.com/HayataSama/SakurajimaSplit",
    "tags": ["split", "ortho", "column-stagger"],
    "bootloader_instructions": "Hold BOOT0 button and connect the keyboard to your PC",
    "processor": "STM32G0B1",
    "bootloader": "stm32-dfu",
    "build": {
        "lto": true
    },
    "features": {
        "bootmagic": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "usb": {
        "device_version": "1.0.0",
        "pid": "0xAACC",
        "vid": "0xFEED"
    },
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "cols": ["A8", "A15", "D0", "D1", "D2", "D3"],
        "rows": ["B4", "B6", "B7", "B8"]
    },
    // "indicators": {
    //     "caps_lock": "A4"
    // },
    "split": {
        "enabled": true,
        "matrix_pins": {
            "right": {
                "cols": ["B13", "B14", "B15", "A8", "A9", "C6"],
                "rows": ["B12", "B11", "B10", "B2"]
            }
        },
        "serial": {
            "driver": "usart"
        },
        "transport": {
            "protocol": "serial"
            // "sync": {
            //     "activity": true,
            //     "indicators": true,
            //     "oled": true,
            //     "wpm": true,
            //     "modifiers": true,
            //     "layer_state": true,
            //     "matrix_state": true
            // }
        }
    },
    // "eeprom": {
    //     "driver": "",
    //     "wear_leveling": {
    //         "driver": "",
    //         "backing_size": 0,
    //         "logical_size": 0
    //     }
    // },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "tab", "matrix": [0, 0], "x": 0, "y": 0.75},
                {"label": "q", "matrix": [0, 1], "x": 1, "y": 0.75},
                {"label": "w", "matrix": [0, 2], "x": 2, "y": 0.5},
                {"label": "e", "matrix": [0, 3], "x": 3, "y": 0},
                {"label": "r", "matrix": [0, 4], "x": 4, "y": 0.5},
                {"label": "t", "matrix": [0, 5], "x": 5, "y": 0.75},

                {"label": "y", "matrix": [4, 0], "x": 10, "y": 0.75},
                {"label": "u", "matrix": [4, 1], "x": 11, "y": 0.5},
                {"label": "i", "matrix": [4, 2], "x": 12, "y": 0},
                {"label": "o", "matrix": [4, 3], "x": 13, "y": 0.5},
                {"label": "p", "matrix": [4, 4], "x": 14, "y": 0.75},
                {"label": "bspc", "matrix": [4, 5], "x": 15, "y": 0.75},

                {"label": "lctl", "matrix": [1, 0], "x": 0, "y": 1.75},
                {"label": "a", "matrix": [1, 1], "x": 1, "y": 1.75},
                {"label": "s", "matrix": [1, 2], "x": 2, "y": 1.5},
                {"label": "d", "matrix": [1, 3], "x": 3, "y": 1},
                {"label": "f", "matrix": [1, 4], "x": 4, "y": 1.5},
                {"label": "g", "matrix": [1, 5], "x": 5, "y": 1.75},

                {"label": "h", "matrix": [5, 0], "x": 10, "y": 1.75},
                {"label": "j", "matrix": [5, 1], "x": 11, "y": 1.5},
                {"label": "k", "matrix": [5, 2], "x": 12, "y": 1},
                {"label": "l", "matrix": [5, 3], "x": 13, "y": 1.5},
                {"label": ";", "matrix": [5, 4], "x": 14, "y": 1.75},
                {"label": "'", "matrix": [5, 5], "x": 15, "y": 1.75},

                {"label": "lsft", "matrix": [2, 0], "x": 0, "y": 2.75},
                {"label": "z", "matrix": [2, 1], "x": 1, "y": 2.75},
                {"label": "x", "matrix": [2, 2], "x": 2, "y": 2.5},
                {"label": "c", "matrix": [2, 3], "x": 3, "y": 2},
                {"label": "v", "matrix": [2, 4], "x": 4, "y": 2.5},
                {"label": "b", "matrix": [2, 5], "x": 5, "y": 2.75},

                {"label": "n", "matrix": [6, 0], "x": 10, "y": 2.75},
                {"label": "m", "matrix": [6, 1], "x": 11, "y": 2.5},
                {"label": ",", "matrix": [6, 2], "x": 12, "y": 2},
                {"label": ".", "matrix": [6, 3], "x": 13, "y": 2.5},
                {"label": "/", "matrix": [6, 4], "x": 14, "y": 2.75},
                {"label": "rsft", "matrix": [6, 5], "x": 15, "y": 2.75},

                {"label": "lgui", "matrix": [3, 3], "x": 3.875, "y": 3.75},
                {"label": "bspc", "matrix": [3, 4], "x": 5.125, "y": 4, "r": -70, "rx": 5.625, "ry": 4.5},
                {"label": "spc", "matrix": [3, 5], "x": 6, "y": 4.5, "r": -52, "rx": 6.75, "ry": 5},

                {"label": "spc", "matrix": [7, 0], "x": 8.5, "y": 4.5, "r": -52, "rx": 9.25, "ry": 5},
                {"label": "ent", "matrix": [7, 1], "x": 9.875, "y": 4, "r": -70, "rx": 10.375, "ry": 4.5},
                {"label": "ralt", "matrix": [7, 2], "x": 11.125, "y": 3.75}
            ]
        }
    }
}
